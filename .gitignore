# Keep the Ray lesson folder tracked while still ignoring generated data under it.
!Ray/3_ray_data/
Ray/3_ray_data/_tmp_ray_data_unit_*/
Ray/3_ray_data/fake_data/

# Distributed DL lesson-generated fake data
Distributed_DL/2_training_challenges/fake_data/

# Ray cluster scratch space
Ray/.tmp-ray-host/
Ray/1_cluster_setup/head_workspace/*
!Ray/1_cluster_setup/head_workspace/.gitkeep

# Live unit material
/Distributed_DL/5_scaling_strategies/*
!/Distributed_DL/5_scaling_strategies/README.md

# Preserve cloud GPU output logs while ignoring logs everywhere else.
!Distributed_DL/4_ddp_on_cloud_gpus/runpod_output/
!Distributed_DL/4_ddp_on_cloud_gpus/runpod_output/**/
!Distributed_DL/4_ddp_on_cloud_gpus/runpod_output/**/*.log
!Distributed_DL/4_ddp_on_cloud_gpus/colab_output/
!Distributed_DL/4_ddp_on_cloud_gpus/colab_output/**/
!Distributed_DL/4_ddp_on_cloud_gpus/colab_output/**/*.log
